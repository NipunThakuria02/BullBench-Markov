# Copy this file to .env and fill in values as needed.
# The backend reads these from the process environment, not from this file automatically.

# Paths to data directories (defaults shown)
BULLBENCH_SNAPSHOTS=data/exploratory_snapshots
BULLBENCH_REGISTRY=model_registry

# CORS origins the backend will accept (comma-separated, no trailing slash)
BULLBENCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 1 to serve saved legacy results from data/legacy_site (local dev only)
BULLBENCH_LOCAL_LEGACY=1
BULLBENCH_LEGACY_SITE=data/legacy_site

# Frontend: set this to your backend URL when running backend and frontend on separate hosts
# VITE_API_BASE_URL=https://your-backend.onrender.com
