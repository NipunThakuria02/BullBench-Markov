# Examples only. The API reads process environment, not this file automatically.
# Local defaults (run_local.py sets absolute paths itself):
BULLBENCH_SNAPSHOTS=data/exploratory_snapshots
BULLBENCH_REGISTRY=model_registry
BULLBENCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In Vercel's environment settings set VITE_API_BASE_URL to the actual HTTPS backend origin.
# On the backend set BULLBENCH_CORS_ORIGINS to the actual HTTPS frontend origin.
